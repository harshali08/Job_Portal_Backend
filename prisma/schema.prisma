// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  user_name String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  createdJobs     JobPost[] @relation("JobsCreated")
  updatedJobs     JobPost[] @relation("JobsUpdated")
  createCompanies Company[] @relation("CompaniesCreated")
  updateCompanies Company[] @relation("CompaniesUpdated")
  companies       Company[]
}

model JobPost {
  id                  String   @id @default(uuid())
  job_role            String
  job_type            String
  job_description     String
  company             String
  salary              Int? // optional
  location            String? // optional
  category            String
  education           String[]
  key_responsibities  String[]
  professional_skills String[]
  tags                String[] // array of strings
  experience          Int?
  created_by          String
  updated_by          String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  creator User @relation("JobsCreated", fields: [created_by], references: [id])
  updater User @relation("JobsUpdated", fields: [updated_by], references: [id])
}

model Company {
  id               String   @id @default(uuid())
  company_name     String   @unique
  company_location String[]
  company_details  String
  created_by       String
  updated_by       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  creator User    @relation("CompaniesCreated", fields: [created_by], references: [id])
  updater User    @relation("CompaniesUpdated", fields: [updated_by], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
  userId  String?
}
